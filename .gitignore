.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
.claude
.vercel
# Local temp plugin sandboxes
temp_notemus_multiplatform/
temp_notemus_plugin/

# Auto-generated test automation artifacts
.playwright-cli/

# Flutter-generated CMake ephemeral files (not part of plugin source)
linux/flutter/

# Generated Flutter registrant (Android app)
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Flutter golden test failure diffs (transient)
test/**/failures/

# Ad-hoc measurement probes (throwaway test scripts, never committed).
# Also excluded in analysis_options.yaml so `dart analyze` at the repo root
# matches `dart analyze lib` (measured: 470 issues at root vs 0 in lib).
probe/

# Flutter-generated plugin registrants for the example app. `flutter pub get`
# rewrites these on every resolve, so tracking them makes a clean checkout go
# dirty the moment anyone runs pub get — which is what `pub publish --dry-run`
# reports as "checked-in files are modified in git", and what turned the CI
# publish-readiness job red. They are regenerated on demand; nothing is lost.
**/flutter/generated_plugin_registrant.cc
**/flutter/generated_plugin_registrant.h
**/flutter/generated_plugins.cmake
**/lib/generated_plugin_registrant.dart
